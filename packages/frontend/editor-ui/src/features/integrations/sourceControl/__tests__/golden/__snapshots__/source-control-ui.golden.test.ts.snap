exports[`the source control editor > the pull modal 1`] = `
{
  "a changed credential and a conflicting data table": [
    {
      "effects": [
        [
          "request",
          "GET /projects",
        ],
        [
          "request",
          "GET /source-control/get-status params {'direction':'pull','preferLocalVersion':false,'verbose':false}",
        ],
      ],
      "mounted": true,
      "screen": {
        "modal": {
          "controls": [
            "a href=https://docs.n8n.io/source-control-environments/using/push-pull: More info",
            "button: Close this dialog",
            "input type=text role=combobox value="Off": Select",
            "button #source-control-pull-modal-tab-workflow: Workflows0 items",
            "button #source-control-pull-modal-tab-credential: Credentials1 item",
            "button #source-control-pull-modal-tab-datatable: Data Tables2 items",
            "button: Cancel",
            "button #force-pull: Pull",
          ],
          "icons": [
            "info",
            "triangle-alert",
          ],
          "testIds": [
            "auto-publish-select: ",
            "source-control-pull-modal-tab-workflow: Workflows0 items",
            "source-control-pull-modal-tab-credential: Credentials1 item",
            "source-control-pull-modal-tab-datatable: Data Tables2 items",
            "force-pull: Pull",
          ],
          "text": "Pull changesThese resources will be updated or deleted, and any local changes to them will be lost. To keep the local version, push it before pulling. More infoAuto-publish pulled versionWorkflows0 itemsCredentials1 itemData Tables2 itemsTitleNo workflows foundModified credentials will update expressions, numbers, and boolean values, any other values are not available to pull via environments, because secret values cannot be synced.The following 2 data tables have schema changes. Column removal will cause data loss that cannot be recovered:TableOther table CancelPull",
        },
        "modals": [
          "sourceControlPull",
        ],
        "route": "/home/workflows?sourceControl=pull",
      },
    },
    {
      "click": "source-control-pull-modal-tab-datatable",
      "screen": {
        "modal": {
          "controls": [
            "a href=https://docs.n8n.io/source-control-environments/using/push-pull: More info",
            "button: Close this dialog",
            "input type=text role=combobox value="Off": Select",
            "button #source-control-pull-modal-tab-workflow: Workflows0 items",
            "button #source-control-pull-modal-tab-credential: Credentials1 item",
            "button #source-control-pull-modal-tab-datatable: Data Tables2 items",
            "button: Cancel",
            "button #force-pull: Pull",
          ],
          "icons": [
            "triangle-alert",
          ],
