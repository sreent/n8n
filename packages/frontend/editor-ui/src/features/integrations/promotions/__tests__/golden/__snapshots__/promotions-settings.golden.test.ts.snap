          },
        ],
        [
          "request",
          "GET /api/v1/promotions/providers params {'cursor':'<undefined>'}",
        ],
        [
          "request",
          "GET /api/v1/promotions/connections params {'cursor':'<undefined>','scope':'instance'}",
        ],
