exports[`the editor of Git connections > the module descriptor, the constants and the event bus 1`] = `
{
  "constants": {
    "PROMOTIONS_SETTINGS_VIEW": "PromotionsSettings",
    "PROMOTION_SELECT_MODAL_KEY": "promotionSelect",
  },
  "descriptor": {
    "description": "Promote workflow changes between environments",
    "icon": "upload",
    "id": "promotions",
    "modals": [
      {
        "component": "<function>",
        "initialState": {
          "data": {
            "projectId": "",
          },
          "open": false,
        },
        "key": "promotionSelect",
      },
    ],
    "name": "Promotions",
    "routes": [
      {
        "beforeEnter": "<function>",
        "component": "<function>",
        "meta": {
          "layout": "settings",
          "middleware": [
            "authenticated",
            "rbac",
            "custom",
          ],
          "middlewareOptions": {
            "rbac": {
              "options": {
                "mode": "allOf",
              },
              "scope": [
                "gitConnection:list",
                "gitConnection:read",
                "gitConnection:create",
                "gitConnection:update",
                "gitConnection:delete",
              ],
            },
          },
          "telemetry": {
            "getProperties": "<function>",
            "pageCategory": "settings",
          },
        },
        "name": "PromotionsSettings",
        "path": "promotions",
      },
    ],
  },
  "effects": {},
  "eventBus": [
    "emit",
    "off",
    "on",
    "once",
  ],
  "guard while enabled": true,
  "guard while the flag is off": {
    "name": "Homepage",
  },
  "guard while the module is off": {
    "name": "Homepage",
  },
  "telemetry": {
    "feature": "promotions",
  },
}
`;

