exports[`the completions > complete $vars without variables 1`] = `
{
  "from": 0,
  "options": [],
}
`;

exports[`the modules > export these names and constants 1`] = `
{
  "completions": [
    "addVarType",
    "useVariablesCompletions",
  ],
  "constants": {
    "VARIABLE_MODAL_KEY": "variableModal",
  },
  "defaultExportIsTheStore": true,
  "store": [
    "default",
    "useEnvironmentsStore",
  ],
  "storeId": "environments",
  "storeMembers": [
    "createVariable: function",
    "deleteVariable: function",
    "fetchAllVariables: function",
    "getVariablesInScope: function",
    "scopedVariables: object",
    "updateVariable: function",
    "variables: object",
    "variablesAsObject: object",
  ],
}
`;

