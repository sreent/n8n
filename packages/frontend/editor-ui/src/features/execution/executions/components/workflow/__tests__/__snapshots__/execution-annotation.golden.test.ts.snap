  <!--teleport end-->
  <!--v-if-->
</div>",
  "emptyPanel": "<div class="execution-annotation-panel container" data-test-id="execution-annotation-panel"><div class="section"><div class="heading"><h3 class="n8n-heading text-dark size-small regular">Highlighted data</h3></div><div class="noResultsContainer" data-test-id="execution-annotation-data-empty"><span class="n8n-text align-center text-base size-small regular"><span>Show important data from executions here by adding an <a target="_blank" href="https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.executiondata/">execution data</a> node to your workflow</span></span></div></div></div>",
  "panel": "<div class="execution-annotation-panel container" data-test-id="execution-annotation-panel"><div class="section"><div class="heading"><h3 class="n8n-heading text-dark size-small regular">Highlighted data</h3></div><div class="metadata"><div class="customDataEntry"><span class="n8n-text text-base size-small regular key key">orderId</span><span class="n8n-text text-base size-small regular value value">A-1</span></div><div class="customDataEntry"><span class="n8n-text text-base size-small regular key key">customer</span><span class="n8n-text text-base size-small regular value value">Acme Corp</span></div></div></div></div>",
}
