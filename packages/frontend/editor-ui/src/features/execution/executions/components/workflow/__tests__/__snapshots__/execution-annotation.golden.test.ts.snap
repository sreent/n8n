    <div class="button-inner"><svg viewBox="0 0 24 24" width="12px" height="12px" class="n8n-icon" aria-hidden="true" focusable="false" role="img" data-icon="list-checks">
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5h8m-8 7h8m-8 7h8M3 17l2 2l4-4M3 7l2 2l4-4"></path>
