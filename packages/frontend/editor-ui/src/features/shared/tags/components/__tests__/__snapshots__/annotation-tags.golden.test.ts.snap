exports[`AnnotationTagsManager > fetches, creates, renames and deletes tags, with the toasts 1`] = `
{
  "create": {
    "result": {
      "id": "tag-3",
      "name": "New",
    },
  },
  "createCalls": [
    [
      "New",
    ],
    [
      "<b>Bold</b>",
    ],
  ],
  "createError": {
    "error": "create failed",
  },
  "delete": {
    "result": true,
  },
  "deleteCalls": [
    [
      "tag-2",
    ],
    [
      "tag-1",
    ],
    [
      "unknown",
    ],
  ],
  "deleteError": {
    "error": "delete failed",
  },
  "deleteFalse": {
    "error": "Could not delete tag",
  },
  "fetch": {
    "result": undefined,
  },
  "fetchAllCalls": [
    [
      {
        "force": true,
        "withUsageCount": true,
      },
    ],
    [
      {
        "force": true,
        "withUsageCount": true,
      },
    ],
  ],
  "fetchError": {
    "result": undefined,
  },
  "rename": {
    "result": {
      "id": "tag-1",
      "name": "Great",
    },
  },
  "renameCalls": [
    [
      {
        "id": "tag-1",
        "name": "Great",
      },
    ],
    [
      {
        "id": "tag-1",
        "name": "Great & Co",
      },
    ],
  ],
  "renameError": {
    "error": "rename failed",
  },
  "toasts": [
    [
      "showError",
      [
        "<Error fetch failed>",
        "Could not fetch tags",
        {
          "message": "A problem occurred when trying to fetch tags",
        },
      ],
    ],
    [
      "showError",
      [
        "<Error create failed>",
        "Could not create tag",
        {
          "message": "A problem occurred when trying to create the tag '%3Cb%3EBold%3C/b%3E':",
        },
      ],
    ],
    [
      "showMessage",
      [
        {
          "title": "Tag updated",
          "type": "success",
        },
      ],
    ],
    [
      "showError",
      [
        "<Error rename failed>",
        "Could not update tag",
        {
          "message": "A problem occurred when trying to update the tag 'Great%20%26%20Co':",
        },
      ],
    ],
    [
      "showMessage",
      [
        {
          "title": "Tag deleted",
          "type": "success",
        },
      ],
    ],
    [
      "showError",
      [
        "<Error Could not delete tag>",
        "Could not delete tag",
        {
          "message": "A problem occurred when trying to delete the tag 'Good':",
        },
      ],
    ],
    [
      "showError",
      [
        "<Error delete failed>",
        "Could not delete tag",
        {
          "message": "A problem occurred when trying to delete the tag '':",
        },
      ],
    ],
  ],
}
`;

