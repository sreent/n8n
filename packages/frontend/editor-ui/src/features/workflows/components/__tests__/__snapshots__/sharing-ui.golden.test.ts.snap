// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sharing UI > API helpers 1`] = `
{
  "exports": {
    "credentials": [
      "moveCredentialToProject",
      "setCredentialSharedWith",
    ],
    "workflows": [
      "moveFolderToProject",
      "moveWorkflowToProject",
      "setWorkflowSharedWith",
    ],
  },
  "moveCredentialToProject": {
    "calls": [
      [
        "request",
        "PUT /credentials/cred-1/transfer data {'destinationProjectId':'p-team'}",
      ],
    ],
    "result": "<server result>",
  },
  "moveCredentialToProject that fails": {
    "calls": [
      [
        "request",
        "PUT /credentials/cred-1/transfer data {'destinationProjectId':'p-team'}",
      ],
    ],
    "error": "ResponseError: Not found",
  },
  "moveFolderToProject": {
    "calls": [
      [
        "request",
        "PUT /projects/p-a/folders/folder-1/transfer data {'destinationParentFolderId':'folder-2','destinationProjectId':'p-team','shareCredentials':['cred-1','cred-2']}",
      ],
    ],
    "result": "<server result>",
  },
  "moveFolderToProject to the root": {
    "calls": [
      [
        "request",
        "PUT /projects/p-a/folders/folder-1/transfer data {'destinationParentFolderId':'0','destinationProjectId':'p-team','shareCredentials':'<undefined>'}",
      ],
    ],
    "result": "<server result>",
  },
  "moveWorkflowToProject": {
    "calls": [
      [
        "request",
        "PUT /workflows/wf-a/transfer data {'destinationParentFolderId':'folder-1','destinationProjectId':'p-team','shareCredentials':['cred-1']}",
      ],
    ],
    "result": "<server result>",
  },
  "moveWorkflowToProject that fails": {
    "calls": [
      [
        "request",
        "PUT /workflows/wf-a/transfer data {'destinationProjectId':'p-team'}",
      ],
    ],
    "error": "ResponseError: Transfer failed",
  },
  "moveWorkflowToProject with an activation error": {
    "calls": [
      [
        "request",
        "PUT /workflows/wf-a/transfer data {'destinationProjectId':'p-activation-error'}",
      ],
    ],
    "result": {
      "error": {
        "message": "Activation failed",
        "name": "WorkflowActivationError",
      },
    },
  },
  "moveWorkflowToProject with the project only": {
    "calls": [
      [
        "request",
        "PUT /workflows/wf-a/transfer data {'destinationProjectId':'p-team'}",
      ],
    ],
    "result": "<server result>",
  },
  "setCredentialSharedWith": {
    "calls": [
      [
        "request",
        "PUT /credentials/cred-1/share data {'shareWithIds':['p-b']}",
      ],
    ],
    "result": "<server result>",
  },
  "setWorkflowSharedWith": {
    "calls": [
      [
        "request",
        "PUT /workflows/wf-a/share data {'shareWithIds':['p-b','p-c']}",
      ],
    ],
    "result": "<server result>",
  },
  "setWorkflowSharedWith with no projects": {
    "calls": [
      [
        "request",
        "PUT /workflows/wf-a/share data {'shareWithIds':[]}",
      ],
    ],
    "result": "<server result>",
  },
}
`;

