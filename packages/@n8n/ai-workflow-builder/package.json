{
  "name": "@n8n/ai-workflow-builder",
  "version": "1.0.0",
  "description": "Fork code: the parts of the AI workflow builder that the MCP tools of n8n use",
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "pnpm watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest --silent=false"
  },
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@langchain/core": "catalog:",
    "@n8n/backend-network": "workspace:*",
    "@n8n/utils": "workspace:*",
    "@n8n/workflow-sdk": "workspace:*",
    "@n8n_io/ai-assistant-sdk": "catalog:",
    "n8n-workflow": "workspace:*"
  },
  "devDependencies": {
    "@n8n/oxlint-config": "workspace:*",
    "@n8n/typescript-config": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:typescript",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
