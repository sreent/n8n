exports[`SSO helpers > a second change of the method, and a stored method that differs from the config 1`] = `
{
  "email to saml to oidc": {
    "config": {
      "ldap": {
        "loginEnabled": false,
      },
      "method": "oidc",
      "oidc": {
        "loginEnabled": false,
      },
      "saml": {
        "loginEnabled": false,
        "loginLabel": "",
      },
    },
    "first": {
      "settings": {
        "added": [
          "{"key":"userManagement.authenticationMethod","value":"saml","loadOnStartup":1}",
        ],
      },
    },
    "second": {
      "settings": {
        "added": [
          "{"key":"userManagement.authenticationMethod","value":"oidc","loadOnStartup":1}",
        ],
        "removed": [
          "{"key":"userManagement.authenticationMethod","value":"saml","loadOnStartup":1}",
        ],
      },
    },
  },
  "row saml, config email": {
    "assertAuthenticationMethodCanBeEnabled": {
      "email": "<undefined>",
      "ldap": "<undefined>",
      "oidc": "<undefined>",
      "saml": "<undefined>",
      "unknown": "<undefined>",
    },
    "getCurrentAuthenticationMethod": "email",
    "getSamlLoginLabel": "",
    "isOidcCurrentAuthenticationMethod": false,
    "isSamlCurrentAuthenticationMethod": false,
    "isSamlLicensed": true,
    "isSamlLicensedAndEnabled": false,
    "isSsoCurrentAuthenticationMethod": false,
  },
}
`;

