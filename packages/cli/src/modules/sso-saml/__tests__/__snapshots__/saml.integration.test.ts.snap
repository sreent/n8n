              "roleType": "global",
              "scopes": "<scope entities>",
              "slug": "global:member",
              "systemRole": true,
              "updatedAt": "<date>",
            },
            "settings": null,
            "updatedAt": "<date>",
          },
        },
      ],
    ],
    "passwords": {
      "@new user claim-a-list@example.com": "new user: <bcrypt hash>",
    },
    "published": [],
    "result": {
      "after": {
        "projects": [],
        "role": "global:admin",
      },
      "response": {
        "body": "<the text of a redirect>",
        "contentType": "text/plain; charset=utf-8",
        "cookies": [
          {
            "attributes": [
              "Max-Age=604800",
              "Path=/",
              "Expires=<date>",
