exports[`SAML > the service 1`] = `
{
  "init | a full row": {
    "database": {
      "settings": {
        "added": [
          "{"key":"userManagement.authenticationMethod","value":"saml","loadOnStartup":1}",
        ],
        "removed": [
          "{"key":"userManagement.authenticationMethod","value":"email","loadOnStartup":1}",
        ],
      },
    },
    "events": [],
    "passwords": {},
    "published": [],
    "result": {
      "acsBinding": "post",
      "authnRequestsSigned": false,
      "ignoreSSL": false,
      "loginBinding": "redirect",
      "loginEnabled": true,
      "loginLabel": "Company SSO",
      "mapping": {
        "email": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
        "firstName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/firstname",
        "lastName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/lastname",
        "userPrincipalName": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn",
      },
      "metadata": "@the IdP metadata",
      "relayState": "http://localhost:5678",
      "signatureConfig": {
        "location": {
          "action": "after",
          "reference": "/samlp:Response/saml:Issuer",
        },
