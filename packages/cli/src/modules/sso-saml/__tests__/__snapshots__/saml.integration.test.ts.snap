      [
        "user-logged-in",
        {
          "authenticationMethod": "saml",
          "user": {
            "createdAt": "<date>",
            "disabled": false,
            "email": "claim-a-list@example.com",
            "firstName": "Claim-a-list",
            "id": "@new user claim-a-list@example.com",
            "isPending": false,
