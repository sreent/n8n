{
  "instance claim | a list": {
    "database": {
      "auth_identity": {
        "added": [
          "{"userId":"@new user claim-a-list@example.com","providerId":"claim-a-list-upn","providerType":"saml","createdAt":"<date>","updatedAt":"<date>"}",
        ],
      },
      "project": {
        "added": [
          "{"id":"@new project Claim-a-list Saml <claim-a-list@example.com>","name":"Claim-a-list Saml <claim-a-list@example.com>","type":"personal","createdAt":"<date>","updatedAt":"<date>","icon":null,"description":null,"creatorId":"@new user claim-a-list@example.com","customTelemetryTags":"[]"}",
        ],
      },
      "project_relation": {
        "added": [
          "{"projectId":"@new project Claim-a-list Saml <claim-a-list@example.com>","userId":"@new user claim-a-list@example.com","role":"project:personalOwner","createdAt":"<date>","updatedAt":"<date>"}",
        ],
      },
      "user": {
        "added": [
          "{"id":"@new user claim-a-list@example.com","email":"claim-a-list@example.com","firstName":"Claim-a-list","lastName":"Saml","personalizationAnswers":null,"createdAt":"<date>","updatedAt":"<date>","disabled":0,"mfaEnabled":0,"mfaSecret":null,"mfaRecoveryCodes":"","lastActiveAt":null,"roleSlug":"global:admin"}",
        ],
      },
    },
    "events": [
