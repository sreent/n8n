exports[`1Password provider > form fields 1`] = `
{
  "displayName": "1Password",
  "name": "onePassword",
  "properties": [
    {
      "default": "",
      "displayName": "Need help filling out these fields? <a href="https://docs.n8n.io/external-secrets/#connect-n8n-to-your-secrets-store" target="_blank">Open docs</a>",
      "name": "notice",
      "noDataExpression": true,
      "type": "notice",
    },
    {
      "default": "",
      "displayName": "Connect Server URL",
      "hint": "URL of your <a href="https://developer.1password.com/docs/connect/get-started/" target="_blank">1Password Connect Server</a>.",
      "name": "serverUrl",
      "noDataExpression": true,
      "placeholder": "e.g. http://localhost:8080",
      "required": true,
      "type": "string",
    },
    {
      "default": "",
      "displayName": "Access Token",
      "hint": "Token created for your Connect Server integration.",
      "name": "accessToken",
      "noDataExpression": true,
      "placeholder": "e.g. eyJhbGciOiJFUzI1NiIsImtpZCI6...",
      "required": true,
      "type": "string",
      "typeOptions": {
        "password": true,
      },
    },
  ],
}
`;

