    "update after the token expires: GET /api/v4/secrets?projectId=proj-1&environment=dev&secretPath=%2F 401 authorization=Bearer at-1",
    "update after the token expires: POST /api/v1/auth/universal-auth/login 200 authorization=Bearer at-1 body={"clientId":"client-1","clientSecret":"secret-1"}",
    "update after the token expires: GET /api/v4/secrets?projectId=proj-1&environment=dev&secretPath=%2F 200 authorization=Bearer at-1",
    "test after the token expires: GET /api/v1/workspace/proj-1 401 authorization=Bearer at-1",
    "update with a token that stays refused: GET /api/v4/secrets?projectId=proj-1&environment=dev&secretPath=%2F 401 authorization=Bearer at-1",
    "update with a token that stays refused: POST /api/v1/auth/universal-auth/login 200 authorization=Bearer at-1 body={"clientId":"client-1","clientSecret":"secret-1"}",
    "update with a token that stays refused: GET /api/v4/secrets?projectId=proj-1&environment=dev&secretPath=%2F 401 authorization=Bearer at-1",
    "update when the new login fails: GET /api/v4/secrets?projectId=proj-1&environment=dev&secretPath=%2F 401 authorization=Bearer at-1",
    "update when the new login fails: POST /api/v1/auth/universal-auth/login 401 authorization=Bearer at-1 body={"clientId":"client-1","clientSecret":"secret-1"}",
    "update after the failed login: GET /api/v4/secrets?projectId=proj-1&environment=dev&secretPath=%2F 401 authorization=Bearer at-1",
    "update after the failed login: POST /api/v1/auth/universal-auth/login 200 authorization=Bearer at-1 body={"clientId":"client-1","clientSecret":"secret-1"}",
    "update after the failed login: GET /api/v4/secrets?projectId=proj-1&environment=dev&secretPath=%2F 200 authorization=Bearer at-1",
  ],
  "state": "connected",
  "test after the token expires": {
    "ok": [
      false,
      "Invalid credentials",
    ],
  },
  "update after the failed login": "ok",
  "update after the token expires": "ok",
  "update when the new login fails": {
    "error": "AxiosError < Error: Request failed with status code 401",
  },
  "update with a token that stays refused": {
    "error": "AxiosError < Error: Request failed with status code 401",
  },
}
`;

