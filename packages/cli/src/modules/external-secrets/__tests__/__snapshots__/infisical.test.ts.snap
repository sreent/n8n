exports[`Infisical provider > form fields 1`] = `
{
  "displayName": "Infisical",
  "name": "infisical",
  "properties": [
    {
      "default": "",
      "displayName": "Need help filling out these fields? <a href="https://docs.n8n.io/external-secrets/#connect-n8n-to-your-secrets-store" target="_blank">Open docs</a>",
      "name": "notice",
      "noDataExpression": true,
      "type": "notice",
    },
    {
      "default": "https://app.infisical.com",
      "displayName": "Site URL",
      "hint": "The absolute URL of the Infisical instance. Change it only if you're self-hosting Infisical.",
      "name": "siteURL",
      "noDataExpression": true,
      "placeholder": "https://app.infisical.com",
      "required": true,
      "type": "string",
    },
    {
      "default": "",
      "displayName": "Project ID",
      "hint": "The Infisical project to read secrets from",
      "name": "projectId",
      "noDataExpression": true,
      "placeholder": "e.g. 7c1cbe9c-3f1b-4a92-b3a2-9d5e2f1c8a4b",
      "required": true,
      "type": "string",
    },
    {
      "default": "dev",
      "displayName": "Environment",
      "hint": "Environment slug (e.g. dev, staging, prod)",
      "name": "environment",
      "noDataExpression": true,
      "placeholder": "dev",
      "required": true,
      "type": "string",
    },
    {
      "default": "/",
      "displayName": "Secret Path",
      "hint": "The path within the project to read secrets from",
      "name": "secretPath",
      "noDataExpression": true,
      "placeholder": "/",
      "required": true,
      "type": "string",
    },
    {
      "default": "universalAuth",
      "displayName": "Authentication Method",
      "name": "authMethod",
      "noDataExpression": true,
      "options": [
        {
          "name": "Universal Auth",
          "value": "universalAuth",
        },
      ],
      "required": true,
      "type": "options",
    },
    {
      "default": "",
      "displayName": "Client ID",
      "displayOptions": {
        "show": {
          "authMethod": [
            "universalAuth",
          ],
        },
      },
      "name": "clientId",
      "noDataExpression": true,
      "placeholder": "e.g. 8a7b1f1c-9f2a-4d6c-bf1a-2c4e6f8b1d3a",
      "required": true,
      "type": "string",
    },
    {
      "default": "",
      "displayName": "Client Secret",
      "displayOptions": {
        "show": {
          "authMethod": [
            "universalAuth",
          ],
        },
      },
      "name": "clientSecret",
      "noDataExpression": true,
      "placeholder": "***************",
      "required": true,
      "type": "string",
      "typeOptions": {
        "password": true,
      },
    },
  ],
}
`;

