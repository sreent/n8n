exports[`Azure Key Vault provider > form fields 1`] = `
{
  "displayName": "Azure Key Vault",
  "name": "azureKeyVault",
  "properties": [
    {
      "default": "",
      "displayName": "Need help filling out these fields? <a href="https://docs.n8n.io/external-secrets/#connect-n8n-to-your-secrets-store" target="_blank">Open docs</a>",
      "name": "notice",
      "noDataExpression": true,
      "type": "notice",
    },
    {
      "default": "public",
      "displayName": "Azure Cloud",
      "hint": "The Azure cloud environment your Key Vault is hosted in.",
      "name": "environment",
      "noDataExpression": true,
      "options": [
        {
          "description": "Uses <code>vault.azure.net</code> and <code>login.microsoftonline.com</code>",
          "name": "Azure Public Cloud",
          "value": "public",
        },
        {
          "description": "Uses <code>vault.usgovcloudapi.net</code> and <code>login.microsoftonline.us</code>",
          "name": "Azure US Government",
          "value": "usGovernment",
        },
        {
          "description": "Uses <code>vault.azure.cn</code> and <code>login.partner.microsoftonline.cn</code>",
          "name": "Azure China",
          "value": "china",
        },
        {
          "description": "Provide the vault URL and authority host directly, for setups such as Azure Stack or proxied environments",
          "name": "Custom",
          "value": "custom",
        },
      ],
      "type": "options",
    },
    {
      "default": "",
      "displayName": "Vault Name",
      "displayOptions": {
        "hide": {
          "environment": [
            "custom",
          ],
        },
      },
      "hint": "The name of your existing Azure Key Vault.",
      "name": "vaultName",
      "noDataExpression": true,
      "placeholder": "e.g. my-vault",
      "required": true,
      "type": "string",
    },
    {
      "default": "",
      "displayName": "Vault URL",
      "displayOptions": {
        "show": {
