            "custom",
          ],
        },
      },
      "hint": "The full URL of your existing Azure Key Vault.",
      "name": "vaultUrl",
      "noDataExpression": true,
      "placeholder": "e.g. https://my-vault.vault.usgovcloudapi.net",
      "required": true,
      "type": "string",
    },
    {
      "default": "",
