exports[`Azure Key Vault provider > calls before connect, repeated updates, a second connect, and calls after disconnect 1`] = `
{
  "after a change": [
    "new",
  ],
  "after the failing update": {
    "names": [
      "new",
    ],
    "state": "connected",
  },
  "failing update": {
    "error": "Error: boom",
  },
  "log": [
    [
      "connect",
      "new ClientSecretCredential",
      "tenant-1",
      "client-1",
      "secret-1",
      {
        "authorityHost": "https://login.microsoftonline.com",
      },
