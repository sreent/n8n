      "new SecretClient",
      "https://my-vault.vault.azure.net/",
      "ClientSecretCredential",
    ],
    [
      "update",
      "SecretClient.listPropertiesOfSecrets",
    ],
    [
      "update",
      "listed secret taken",
      "db-password",
    ],
    [
      "update",
      "listed secret taken",
      "disabled",
    ],
    [
      "update",
      "listed secret taken",
      "empty",
    ],
    [
      "update",
      "listed secret taken",
      "novalue",
    ],
    [
      "update",
      "listed secret taken",
      "multi-line",
    ],
    [
      "update",
      "listed secret taken",
      "no-flag",
    ],
    [
      "update",
      "SecretClient.getSecret",
      "db-password",
    ],
    [
      "update",
      "SecretClient.getSecret",
      "empty",
    ],
    [
      "update",
      "SecretClient.getSecret",
      "novalue",
    ],
    [
      "update",
      "SecretClient.getSecret",
      "multi-line",
    ],
    [
      "update",
      "SecretClient.getSecret",
      "no-flag",
    ],
    [
      "update",
      "SecretClient.listPropertiesOfSecrets",
    ],
    [
      "update",
      "listed secret taken",
      "new",
    ],
    [
      "update",
      "SecretClient.getSecret",
      "new",
    ],
    [
      "update",
      "SecretClient.listPropertiesOfSecrets",
    ],
    [
      "connect again",
      "new ClientSecretCredential",
      "tenant-1",
      "client-1",
      "secret-1",
      {
        "authorityHost": "https://login.microsoftonline.com",
      },
    ],
    [
      "connect again",
      "new SecretClient",
      "https://my-vault.vault.azure.net/",
      "ClientSecretCredential",
    ],
    [
      "test after disconnect",
      "SecretClient.listPropertiesOfSecrets",
    ],
    [
      "test after disconnect",
      "listed secret taken",
      "new",
    ],
  ],
  "test after disconnect": {
    "ok": [
      true,
    ],
  },
  "test before connect": {
    "ok": [
      false,
      "Failed to connect to Azure Key Vault",
    ],
  },
  "update before connect": {
    "error": "TypeError < Error: Cannot read properties of undefined (reading 'listPropertiesOfSecrets')",
  },
}
`;

