// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SecretsProvider > a connect that does not end 1`] = `
{
  "after": "error",
  "elapsed": "1000 ms",
  "result": "ok",
}
`;

exports[`SecretsProvider > a connect that ends after the timeout 1`] = `
{
  "afterConnect": "error",
  "elapsed": "1000 ms",
  "later": "error",
  "result": "ok",
}
`;

exports[`SecretsProvider > a connect that succeeds 1`] = `
{
  "after": "connected",
  "before": "initializing",
  "during": [
    "connecting",
    "connecting",
  ],
  "result": "ok",
}
`;

exports[`SecretsProvider > a connect that throws a value that is not an error 1`] = `
{
  "after": "error",
  "result": "ok",
}
`;

exports[`SecretsProvider > a connect that throws an error 1`] = `
{
  "after": "error",
  "result": "ok",
}
`;

exports[`SecretsProvider > a second connect after an error 1`] = `
{
  "afterFirst": "error",
  "afterSecond": "connected",
}
`;
