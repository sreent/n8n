          "client_email": "reader@proj-1.iam.gserviceaccount.com",
          "private_key": "-----BEGIN PRIVATE KEY-----
MII
-----END PRIVATE KEY-----",
        },
        "projectId": "proj-1",
      },
    ],
    [
      "update",
      "listSecrets",
      {
        "parent": "projects/proj-1",
      },
    ],
    [
      "update",
      "accessSecretVersion",
      {
        "name": "projects/proj-1/secrets/db-password/versions/latest",
      },
    ],
    [
      "update",
      "accessSecretVersion",
      {
        "name": "projects/proj-1/secrets/json/versions/latest",
      },
    ],
    [
