      {
        "parent": "projects/proj-1",
      },
    ],
    [
      "update",
      "accessSecretVersion",
      {
        "name": "projects/proj-1/secrets/new/versions/latest",
      },
    ],
    [
      "update",
      "listSecrets",
      {
        "parent": "projects/proj-1",
      },
    ],
    [
      "connect again",
      "new SecretManagerServiceClient",
      {
        "credentials": {
          "client_email": "reader@proj-1.iam.gserviceaccount.com",
          "private_key": "-----BEGIN PRIVATE KEY-----
MII
-----END PRIVATE KEY-----",
        },
        "projectId": "proj-1",
      },
    ],
    [
      "test after disconnect",
      "initialize",
    ],
  ],
  "test after disconnect": {
    "ok": [
      true,
    ],
  },
  "test before connect": {
    "ok": [
      false,
      "Failed to connect to GCP Secrets Manager",
    ],
  },
