    "connect: GET /v1/auth/token/lookup-self 200 token=tok-up",
    "connect: GET /v1/auth/token/lookup-self 200 token=tok-up",
    "connect: GET /v1/sys/mounts 200 token=tok-up",
    "connect: POST /v1/auth/userpass/login/a/b%20c 200 body={"password":"pw"}",
    "update: GET /v1/kv/one 200 token=tok-up",
    "update: GET /v1/secret/data/app/db 200 token=tok-up",
    "update: GET /v1/secret/data/top 200 token=tok-up",
    "update: GET /v1/sys/mounts 200 token=tok-up",
    "update: LIST /v1/kv/ 200 token=tok-up",
    "update: LIST /v1/secret/metadata/ 200 token=tok-up",
    "update: LIST /v1/secret/metadata/app/ 200 token=tok-up",
    "test: GET /v1/auth/token/lookup-self 200 token=tok-up",
    "test: GET /v1/sys/mounts 200 token=tok-up",
  ],
  "result": {
    "connect": "ok",
    "disconnect": "ok",
    "getSecret generic": "ok",
    "getSecret kv": {
      "ok": {
        "one": {
          "x": "y",
        },
      },
    },
    "getSecret noversion": "ok",
    "getSecret secret": {
      "ok": {
        "app": {
          "db": {
            "user": "u",
          },
        },
        "top": {
          "a": "1",
        },
      },
    },
    "hasSecret generic": {
      "ok": false,
    },
    "hasSecret kv": {
      "ok": true,
    },
    "hasSecret noversion": {
      "ok": false,
    },
    "hasSecret secret": {
      "ok": true,
    },
    "init": "ok",
    "names": {
      "ok": [
        "secret.app.db.user",
        "secret.top.a",
        "kv.one.x",
      ],
    },
    "state after connect": "connected",
    "state after disconnect": "connected",
    "state after init": "initializing",
    "state after test": "connected",
    "state after update": "connected",
    "state at start": "initializing",
    "test": {
      "ok": [
        true,
      ],
    },
    "update": "ok",
  },
}
`;

