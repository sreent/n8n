exports[`Vault provider > form fields 1`] = `
{
  "displayName": "HashiCorp Vault",
  "name": "vault",
  "properties": [
    {
      "default": "",
      "displayName": "Need help filling out these fields? <a href="https://docs.n8n.io/external-secrets/#connect-n8n-to-your-secrets-store" target="_blank">Open docs</a>",
      "name": "notice",
      "noDataExpression": true,
      "type": "notice",
    },
    {
      "default": "",
      "displayName": "Vault URL",
      "name": "url",
      "noDataExpression": true,
      "placeholder": "e.g. https://example.com/v1/",
      "required": true,
      "type": "string",
    },
    {
      "default": "",
      "displayName": "Vault Namespace (optional)",
      "hint": "Leave blank if not using namespaces",
      "name": "namespace",
      "noDataExpression": true,
      "placeholder": "e.g. admin",
      "required": false,
      "type": "string",
    },
    {
      "default": "token",
      "displayName": "Authentication Method",
      "name": "authMethod",
      "noDataExpression": true,
      "options": [
        {
          "name": "Token",
          "value": "token",
        },
        {
          "name": "Username and Password",
          "value": "usernameAndPassword",
        },
        {
          "name": "AppRole",
          "value": "appRole",
        },
      ],
      "required": true,
      "type": "options",
    },
    {
      "default": "",
      "displayName": "Token",
      "displayOptions": {
        "show": {
          "authMethod": [
            "token",
          ],
        },
      },
      "name": "token",
      "noDataExpression": true,
      "placeholder": "e.g. hvs.2OCsZxZA6Z9lChbt0janOOZI",
      "required": true,
      "type": "string",
      "typeOptions": {
