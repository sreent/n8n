exports[`Connections API of external secrets > create a connection of two projects 1`] = `
{
  "create": {
    "body": {
      "projectIds": [
        "@P1",
        "@P2",
      ],
      "providerKey": "awsTwo",
      "settings": {
        "password": "aws password",
        "username": "aws user",
      },
      "type": "awsSecretsManager",
    },
    "events": [
      [
        "create",
        "command",
        {
          "command": "reload-external-secrets-providers",
        },
      ],
      [
        "create",
        "event",
        "external-secrets-connection-created",
        {
          "projects": [
            {
              "id": "@P1",
              "name": "Project One",
            },
            {
              "id": "@P2",
              "name": "Project Two",
            },
          ],
          "providerKey": "awsTwo",
          "userId": "@owner",
          "userRole": "global:owner",
          "vaultType": "awsSecretsManager",
        },
      ],
    ],
    "providers": [
      [
        "create",
        "awsSecretsManager#1",
        "init",
        {
          "connected": true,
          "connectedAt": null,
          "settings": {
            "password": "aws password",
            "username": "aws user",
          },
        },
      ],
      [
        "create",
        "awsSecretsManager#1",
        "connect",
      ],
      [
        "create",
        "awsSecretsManager#1",
