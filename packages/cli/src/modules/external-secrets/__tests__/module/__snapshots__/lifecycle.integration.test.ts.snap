exports[`Lifecycle of the external secrets module > a reload by a command from another instance 1`] = `
{
  "events": [],
  "providers": [
    [
      "reload command",
      "dummy#2",
      "init",
      {
        "connected": true,
        "connectedAt": "<date>",
        "settings": {
          "password": "stored password",
          "username": "stored user",
        },
      },
    ],
    [
      "reload command",
      "dummy#2",
      "connect",
    ],
    [
      "reload command",
      "dummy#2",
      "update",
    ],
    [
      "reload command",
      "another#2",
      "init",
      {
        "connected": false,
        "connectedAt": null,
        "settings": {
          "username": "not connected",
        },
      },
    ],
    [
      "reload command",
      "initFails#2",
      "init",
      {
        "connected": true,
        "connectedAt": null,
        "settings": {},
      },
    ],
    [
      "reload command",
      "updateFails#2",
      "init",
      {
        "connected": true,
        "connectedAt": null,
        "settings": {},
      },
    ],
    [
      "reload command",
      "updateFails#2",
      "connect",
    ],
    [
      "reload command",
      "updateFails#2",
      "update",
    ],
    [
      "reload command",
      "another#1",
      "disconnect",
    ],
    [
      "reload command",
      "dummy#1",
      "disconnect",
    ],
  ],
  "proxy": {
    "another": {},
    "dummy": {
      "reloaded": "reloaded value",
    },
    "updateFails": {},
  },
  "result": "<undefined>",
}
`;

