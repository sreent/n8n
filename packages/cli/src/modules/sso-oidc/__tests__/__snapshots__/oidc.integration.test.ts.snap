          "name": "n8n-auth",
          "value": {
            "aud": "n8n:session",
            "browserId": "the hash of req.browserId",
            "hash": "the hash of the user",
            "issuedAt": "now",
            "lifetime": 604800,
            "usedMfa": true,
            "user": "@new user row@example.com",
            "verified": true,
          },
        },
        {
          "attributes": [
            "Max-Age=604800",
            "Path=/",
            "Expires=<date>",
            "HttpOnly",
            "SameSite=Lax",
          ],
          "name": "n8n-oidc-id-token",
          "value": {
            "encrypted": "@id token 109",
            "format": "no key id",
            "length": 920,
          },
        },
      ],
      "location": "/",
      "status": 302,
    },
    "state": {
      "authenticationMethod": "oidc",
      "oidcLoginEnabled": true,
    },
  },
