exports[`OIDC > the logout 1`] = `
{
  "RP-initiated logout, a password session": {
    "database": {
      "invalid_auth_token": {
        "added": [
          "{"token":"@session of user password4","expiresAt":"<date>"}",
        ],
      },
    },
    "events": [],
    "passwords": {},
    "provider": [],
    "published": [],
    "result": {
      "response": {
        "body": {
          "data": {
            "redirectUrl": null,
          },
        },
        "contentType": "application/json; charset=utf-8",
        "cookies": [
          {
            "attributes": [
              "Path=/",
              "Expires=Thu, 01 Jan 1970 00:00:00 GMT",
            ],
            "name": "n8n-auth",
            "value": "<empty>",
          },
          {
            "attributes": [
              "Path=/",
              "Expires=Thu, 01 Jan 1970 00:00:00 GMT",
            ],
            "name": "n8n-oidc-id-token",
            "value": "<empty>",
          },
        ],
        "status": 200,
      },
      "sessionAfterwards": 401,
    },
    "state": {
      "authenticationMethod": "oidc",
      "oidcLoginEnabled": true,
    },
  },
  "RP-initiated logout, an OIDC session": {
    "database": {
      "invalid_auth_token": {
        "added": [
          "{"token":"@session of new user logout5@example.com","expiresAt":"<date>"}",
        ],
      },
      "user": {
        "added": [
          "{"id":"@new user logout5@example.com","email":"logout5@example.com","firstName":null,"lastName":null,"personalizationAnswers":null,"createdAt":"<date>","updatedAt":"<date>","disabled":0,"mfaEnabled":0,"mfaSecret":null,"mfaRecoveryCodes":"","lastActiveAt":"<date>","roleSlug":"global:member"}",
        ],
        "removed": [
          "{"id":"@new user logout5@example.com","email":"logout5@example.com","firstName":null,"lastName":null,"personalizationAnswers":null,"createdAt":"<date>","updatedAt":"<date>","disabled":0,"mfaEnabled":0,"mfaSecret":null,"mfaRecoveryCodes":"","lastActiveAt":null,"roleSlug":"global:member"}",
        ],
      },
    },
    "events": [],
    "passwords": {},
    "provider": [],
    "published": [],
    "result": {
      "response": {
