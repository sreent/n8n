exports[`the local parts of the AI workflow builder > stripImportStatements 1`] = `
{
  "Windows line ends": "const a = 1;",
  "a commented import": "// import { a } from 'b';
const a = 1;",
  "a default import": "const a = 1;",
  "a dynamic import": "const m = await import('x');
const a = 1;",
  "a namespace import": "const a = 1;",
  "a re-export": "export { a } from 'b';
const a = 1;",
  "a side-effect import": "const a = 1;",
  "a type import": "const a = 1;",
  "an import after code": "const a = 1;

export default workflow('a', 'b');",
  "an import in a string": "const text = "import x from 'y'";
const a = 1;",
  "an import over lines": "export default workflow('a', 'b');",
  "double quotes without a semicolon": "const a = 1;",
  "empty code": "",
  "indented imports": "const a = 1;",
  "leading blank lines": "const a = 1;",
  "no import": "const a = 1;
export default workflow('a', 'b');",
  "one import": "export default workflow('a', 'b');",
  "only whitespace": "",
  "two imports on one line": "const c = 1;",
}
`;

