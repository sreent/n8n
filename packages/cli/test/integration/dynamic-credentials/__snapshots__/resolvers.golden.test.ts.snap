exports[`credential resolvers > the types and the system resolver 1`] = `
[
  {
    "outcome": {
      "body": {
        "data": [
          {
            "description": "OAuth2 based credential resolver",
            "displayName": "OAuth2 Resolver",
            "name": "credential-resolver.oauth2-1.0",
            "options": [
              {
                "default": "",
                "description": "OAuth2 server metadata endpoint URL",
                "displayName": "Metadata URL",
                "name": "metadataUri",
                "placeholder": "https://auth.example.com/.well-known/openid-configuration",
                "required": true,
                "type": "string",
              },
              {
                "default": "oauth2-introspection",
                "description": "Validation method to use for token validation",
                "displayName": "Validation Method",
                "name": "validation",
                "options": [
                  {
                    "description": "Validate token via OAuth2 Token Introspection Endpoint",
                    "name": "OAuth2 Token Introspection",
                    "value": "oauth2-introspection",
                  },
                  {
                    "description": "Validate token via OAuth2 UserInfo Endpoint",
                    "name": "OAuth2 UserInfo Endpoint",
                    "value": "oauth2-userinfo",
                  },
                ],
                "type": "options",
              },
              {
                "default": "",
                "description": "OAuth2 client ID for introspection",
                "displayName": "Client ID",
                "displayOptions": {
                  "hide": {
                    "validation": [
                      "oauth2-userinfo",
                    ],
                  },
                  "show": {
                    "validation": [
                      "oauth2-introspection",
                    ],
                  },
                },
                "name": "clientId",
                "type": "string",
              },
              {
                "default": "",
                "description": "OAuth2 client secret for introspection",
                "displayName": "Client Secret",
                "displayOptions": {
                  "hide": {
                    "validation": [
                      "oauth2-userinfo",
                    ],
                  },
                  "show": {
                    "validation": [
                      "oauth2-introspection",
                    ],
                  },
                },
                "name": "clientSecret",
                "type": "string",
                "typeOptions": {
                  "password": true,
                },
              },
              {
                "default": "",
                "description": "Value the access token must carry in its aud claim, identifying this n8n instance as the intended recipient. Leave empty to skip the check. This is not the Client ID: configure your provider to issue an audience for n8n if it does not already.",
                "displayName": "Expected Audience",
                "name": "expectedAudience",
                "placeholder": "https://api.example.com",
                "type": "string",
              },
              {
                "default": "sub",
                "description": "Token claim to use as subject identifier",
                "displayName": "Subject Claim",
                "name": "subjectClaim",
                "type": "string",
              },
            ],
          },
          {
            "description": "Slack-based credential resolver using request signatures",
            "displayName": "Slack Resolver",
            "name": "credential-resolver.slack-1.0",
            "options": [
              {
                "default": "",
                "description": "The signing secret from your Slack App (Basic Information → App Credentials → Signing Secret)",
                "displayName": "Slack Signing Secret",
                "name": "signingSecret",
                "required": true,
                "type": "string",
                "typeOptions": {
                  "password": true,
                },
              },
              {
                "default": "user_id",
                "description": "How to identify unique credential holders",
                "displayName": "Subject Claim",
                "name": "subjectClaim",
                "options": [
                  {
                    "description": "Use Slack user ID as the unique credential key",
                    "name": "User ID",
                    "value": "user_id",
                  },
                  {
                    "description": "Use team_id:user_id as the key (recommended for Enterprise Grid / multi-workspace)",
                    "name": "Team ID + User ID",
                    "value": "team_user",
                  },
                ],
                "type": "options",
              },
            ],
          },
        ],
      },
      "status": 200,
    },
    "step": "GET /types as the owner",
