exports[`credential resolvers > the workflows of a resolver and delete 1`] = `
[
  {
    "outcome": {
      "body": {
        "data": [
          {
            "id": "@workflow First",
            "name": "First",
          },
          {
            "id": "@workflow Active",
            "name": "Active",
          },
