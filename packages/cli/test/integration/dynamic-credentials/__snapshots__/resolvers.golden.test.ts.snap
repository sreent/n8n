      "status": 404,
    },
    "step": "DELETE the resolver again",
  },
  {
    "changes": {
      "resolvers": {
        "removed": [
          "{"id":"@resolver Other","name":"Other","type":"credential-resolver.slack-1.0","config":{"signingSecret":"other","subjectClaim":"team_user"}}",
        ],
      },
      "workflows": {
        "added": [
          "{"name":"Unrelated","active":false,"activeVersionId":null,"settings":{}}",
        ],
        "removed": [
          "{"name":"Unrelated","active":false,"activeVersionId":null,"settings":{"credentialResolverId":"@resolver Other"}}",
        ],
      },
