            "name": "Unrelated",
          },
        ],
      },
      "status": 200,
    },
    "step": "GET the workflows of the other resolver",
  },
  {
    "outcome": {
      "body": {
        "message": "User is missing a scope required to perform this action",
        "status": "error",
      },
      "status": 403,
    },
    "step": "DELETE as a member",
  },
  {
    "activeWorkflowManager": [
      [
        "remove",
        "@workflow Active",
      ],
      [
        "add",
        "@workflow Active",
        "update",
      ],
    ],
    "changes": {
      "credentials": {
        "added": [
          "{"name":"Slack credential","isResolvable":true,"resolvableAllowFallback":false,"resolverId":null}",
        ],
        "removed": [
          "{"name":"Slack credential","isResolvable":true,"resolvableAllowFallback":false,"resolverId":"@resolver Slack"}",
        ],
      },
      "entries": {
        "removed": [
          "{"credential":"@credential Slack credential","subject":"subject-a","resolver":"@resolver Slack","data":{"token":"subject-a"}}",
          "{"credential":"@credential Slack credential","subject":"subject-b","resolver":"@resolver Slack","data":{"token":"subject-b"}}",
        ],
      },
      "resolvers": {
        "removed": [
          "{"id":"@resolver Slack","name":"Slack","type":"credential-resolver.slack-1.0","config":{"signingSecret":"slack-signing-secret","subjectClaim":"team_user"}}",
        ],
      },
      "userEntries": {
        "removed": [
          "{"credential":"@credential Slack credential","user":"@owner","resolver":"@resolver Slack","data":{"token":"owner"}}",
        ],
      },
      "workflows": {
        "added": [
          "{"name":"Active","active":true,"activeVersionId":"<set>","settings":{}}",
          "{"name":"First","active":false,"activeVersionId":null,"settings":{"timezone":"Europe/Berlin"}}",
        ],
        "removed": [
          "{"name":"Active","active":true,"activeVersionId":"<set>","settings":{"credentialResolverId":"@resolver Slack"}}",
          "{"name":"First","active":false,"activeVersionId":null,"settings":{"credentialResolverId":"@resolver Slack","timezone":"Europe/Berlin"}}",
        ],
      },
    },
    "outcome": {
      "body": {
        "data": {
          "success": true,
        },
      },
      "status": 200,
    },
    "step": "DELETE the resolver",
  },
  {
    "outcome": {
      "body": {
        "code": 404,
        "message": "Credential resolver with ID "@resolver Slack" does not exist.",
      },
      "status": 404,
    },
    "step": "GET the deleted resolver",
  },
  {
    "outcome": {
      "body": {
