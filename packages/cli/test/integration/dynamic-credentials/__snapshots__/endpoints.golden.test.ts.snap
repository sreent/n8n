    },
    "step": "check without a credential context",
  },
  {
    "logs": [
      [
        "warn",
        "OAuth2 resolver has no expected audience configured, so access tokens are not bound to this instance. Set an expected audience on the resolver.",
      ],
    ],
    "outcome": {
      "value": {
        "credentials": [
          {
            "authorizationUrl": "http://localhost:5678/rest/credentials/@credential Bound/authorize?token=<random>",
            "credentialId": "@credential Bound",
            "credentialName": "Bound",
            "credentialType": "oAuth2Api",
            "resolverId": "@resolver Introspection",
            "status": "missing",
          },
        ],
        "readyToExecute": false,
      },
    },
    "provider": [
      {
        "body": {
          "token": "active-2",
        },
        "headers": {
          "accept": "application/json",
          "authorization": "Basic aW50cm9zcGVjdGlvbi1jbGllbnQ6aW50cm9zcGVjdGlvbi1zZWNyZXQ=",
          "content-type": "application/x-www-form-urlencoded",
        },
        "method": "POST",
        "path": "/introspect",
      },
    ],
    "step": "check the bound workflow with a bearer token",
  },
  {
    "outcome": {
      "threw": "NotFoundError < ResponseError < BaseError: Workflow not found [404]",
    },
    "step": "check an unknown workflow",
  },
  {
    "events": [
      [
        "dynamic-credential-authorize-rejected",
        {
          "credentialId": "@credential Private",
          "reason": "unauthenticated",
        },
      ],
    ],
    "outcome": {
      "headers": {
        "location": "http://localhost:5678/signin?redirect=http%3A%2F%2Flocalhost%3A5678%2Frest%2Fcredentials%2F@credential Private%2Fauthorize%3Ftoken%3D<random>",
        "vary": "Accept",
      },
      "status": 302,
      "text": "Found. Redirecting to http://localhost:5678/signin?redirect=http%3A%2F%2Flocalhost%3A5678%2Frest%2Fcredentials%2F@credential Private%2Fauthorize%3Ftoken%3D<random>",
    },
    "step": "open the link without a session",
  },
  {
    "events": [
      [
        "dynamic-credential-authorize-rejected",
        {
          "credentialId": "@credential Private",
          "reason": "user-mismatch",
        },
      ],
    ],
    "outcome": {
      "status": 200,
    },
    "renders": [
      [
        "oauth-error-callback",
        {
          "error": {
            "message": "This authorization link was issued for a different account. Sign in as the intended user and open the link again.",
          },
        },
      ],
    ],
    "step": "open the link as the owner",
  },
  {
    "outcome": {
      "headers": {
        "location": "<idp>/authorize?client_id=app-client&redirect_uri=http%3A%2F%2Flocalhost%3A5678%2Frest%2Foauth2-credential%2Fcallback&response_type=code&state=<random>&scope=openid",
        "vary": "Accept",
      },
      "status": 302,
      "text": "Found. Redirecting to <idp>/authorize?client_id=app-client&redirect_uri=http%3A%2F%2Flocalhost%3A5678%2Frest%2Foauth2-credential%2Fcallback&response_type=code&state=<random>&scope=openid",
    },
    "step": "open the link as the member",
  },
  {
    "outcome": {
      "headers": {
        "location": "<idp>/authorize?client_id=app-client&redirect_uri=http%3A%2F%2Flocalhost%3A5678%2Frest%2Foauth2-credential%2Fcallback&response_type=code&state=<random>&scope=openid",
        "vary": "Accept",
      },
      "status": 302,
      "text": "Found. Redirecting to <idp>/authorize?client_id=app-client&redirect_uri=http%3A%2F%2Flocalhost%3A5678%2Frest%2Foauth2-credential%2Fcallback&response_type=code&state=<random>&scope=openid",
    },
    "step": "open the link as the member again",
  },
  {
    "outcome": {
      "status": 200,
    },
    "renders": [
      [
        "oauth-error-callback",
        {
          "error": {
            "message": "This authorization link is invalid or has expired. Please request a new one.",
          },
        },
      ],
    ],
    "step": "open a link with an unknown token",
  },
  {
    "outcome": {
      "status": 200,
    },
    "renders": [
      [
        "oauth-error-callback",
        {
          "error": {
            "message": "Missing authorization token.",
          },
        },
      ],
    ],
    "step": "open a link without a token",
  },
  {
    "outcome": {
      "value": {
        "credentials": [
          {
            "credentialId": "@credential Private",
            "credentialName": "Private",
            "credentialType": "oAuth2Api",
            "resolverId": "system-n8n",
            "revokeUrl": "http://localhost:5678/rest/credentials/@credential Private/revoke?resolverId=system-n8n",
            "status": "configured",
          },
        ],
        "readyToExecute": true,
      },
    },
    "step": "check the system workflow after the member connects",
  },
]
`;

