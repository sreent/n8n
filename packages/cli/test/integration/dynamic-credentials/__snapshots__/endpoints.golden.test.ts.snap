exports[`dynamic credential endpoints > my connection 1`] = `
[
  {
    "changes": {
      "userEntries": {
        "removed": [
          "{"credential":"@credential Private","user":"@owner","resolver":"system-n8n","data":{"oauthTokenData":{"access_token":"owner-token"}}}",
        ],
      },
    },
    "events": [
      [
        "credentials-user-disconnected",
        {
          "credentialId": "@credential Private",
          "credentialType": "oAuth2Api",
          "user": "<user @owner>",
        },
      ],
    ],
    "outcome": {
      "status": 204,
    },
    "step": "the owner removes the connection",
  },
  {
    "outcome": {
      "body": {
        "code": 404,
        "message": "No connection to disconnect",
      },
      "status": 404,
    },
    "step": "the owner removes the connection again",
  },
  {
    "outcome": {
      "body": {
        "code": 404,
        "message": "No connection to disconnect",
      },
      "status": 404,
    },
    "step": "the outsider removes a connection",
  },
  {
    "changes": {
      "userEntries": {
        "removed": [
          "{"credential":"@credential Private","user":"@member","resolver":"system-n8n","data":{"oauthTokenData":{"access_token":"member-token"}}}",
        ],
      },
    },
    "events": [
      [
        "credentials-user-disconnected",
        {
          "credentialId": "@credential Private",
          "credentialType": "oAuth2Api",
          "user": "<user @member>",
        },
      ],
    ],
    "outcome": {
      "status": 204,
    },
    "step": "the member removes the connection",
  },
  {
    "outcome": {
      "body": {
        "code": 404,
        "message": "No connection to disconnect",
      },
      "status": 404,
    },
    "step": "the static credential",
  },
  {
    "outcome": {
      "body": {
        "code": 404,
        "message": "No connection to disconnect",
      },
      "status": 404,
    },
    "step": "the bound credential",
  },
  {
    "outcome": {
      "body": {
        "code": 404,
        "message": "No connection to disconnect",
      },
      "status": 404,
    },
    "step": "an unknown credential",
  },
  {
    "outcome": {
      "body": {
        "message": "Unauthorized",
        "status": "error",
      },
      "status": 401,
    },
    "step": "without a session",
  },
]
`;

