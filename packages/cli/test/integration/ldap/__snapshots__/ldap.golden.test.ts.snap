          "settings": null,
          "signInType": "email",
        },
      },
      "cookie": "<set>",
      "status": 200,
    },
    "step": "a sign-in after the tests",
  },
  {
    "directory": [
      [
        "new Client",
        {
          "connectTimeout": 60000,
          "timeout": 60000,
          "url": "ldap://ldap.example.com:389",
        },
      ],
      [
        "bind",
        "cn=admin,dc=example,dc=com",
        "admin-secret",
      ],
      [
        "unbind",
      ],
    ],
    "outcome": "done",
    "step": "testConnection",
  },
]
`;

