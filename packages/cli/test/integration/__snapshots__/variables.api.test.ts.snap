exports[`with the licence feature > counts the variables against the quota 1`] = `
{
  "afterTwo": {
    "result": {
      "limit": 3,
      "remaining": 1,
    },
  },
  "createWithZero": {
    "body": {
      "code": 400,
      "message": "Variables limit reached",
    },
    "status": 400,
  },
