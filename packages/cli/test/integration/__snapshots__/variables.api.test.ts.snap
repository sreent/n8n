    "result": {
      "limit": 3,
      "remaining": 3,
    },
  },
  "events": [
    [
      "variable-created",
      {
        "user": "<owner>",
        "variableId": "<id 18 (16 chars)>",
        "variableKey": "FIRST",
      },
    ],
    [
      "variable-created",
      {
        "projectId": "<project A>",
        "user": "<owner>",
        "variableId": "<id 19 (16 chars)>",
        "variableKey": "SECOND",
      },
    ],
    [
      "variable-created",
      {
        "user": "<owner>",
        "variableId": "<id 20 (16 chars)>",
        "variableKey": "THIRD",
      },
    ],
    [
      "variable-updated",
      {
        "user": "<owner>",
        "variableId": "<id 18 (16 chars)>",
        "variableKey": "FIRST",
      },
    ],
  ],
  "first": {
    "body": {
      "data": {
        "id": "<id 18 (16 chars)>",
        "key": "FIRST",
        "project": null,
        "type": "string",
        "value": "x",
      },
    },
    "status": 200,
  },
  "fourth": {
    "body": {
      "code": 400,
      "message": "Variables limit reached",
    },
    "status": 400,
  },
  "fourthInProject": {
    "body": {
      "code": 400,
      "message": "Variables limit reached",
    },
    "status": 400,
  },
  "full": {
    "result": {
      "limit": 3,
      "remaining": 0,
    },
  },
  "overQuota": {
    "result": {
      "limit": 2,
      "remaining": 0,
    },
  },
  "second": {
    "body": {
      "data": {
        "id": "<id 19 (16 chars)>",
        "key": "SECOND",
        "project": {
          "id": "<project A>",
        },
        "projectId": "<project A>",
        "type": "string",
        "value": "x",
      },
    },
    "status": 200,
  },
  "third": {
    "body": {
      "data": {
        "id": "<id 20 (16 chars)>",
        "key": "THIRD",
        "project": null,
        "type": "string",
        "value": "x",
      },
    },
    "status": 200,
  },
  "unlimited": {
    "result": null,
  },
  "updateWhenFull": {
    "body": {
      "data": {
        "id": "<id 18 (16 chars)>",
        "key": "FIRST",
        "project": null,
