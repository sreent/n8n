      "message": "Variable with id unknown not found",
    },
    "status": 404,
  },
  "memberUpdatesUnknown": {
    "body": {
      "code": 404,
      "message": "Variable with id unknown not found",
    },
    "status": 404,
  },
  "moveGlobalIntoProjectWithItsKey": {
    "body": {
      "code": 400,
      "message": "A variable with key "IN_A" already exists in the specified project",
    },
    "status": 400,
  },
  "projectAdminDeletesUnknown": {
    "body": {
      "code": 403,
      "message": "You are not allowed to delete this variable",
    },
    "status": 403,
  },
  "renameInProjectToGlobalKey": {
    "body": {
      "code": 400,
      "message": "A variable with key "SHARED" already exists in the specified project",
    },
    "status": 400,
  },
  "unknownProjectWithZeroQuota": {
    "body": {
      "code": 403,
      "message": "You are not allowed to create a variable in this project",
    },
    "status": 403,
  },
}
`;

