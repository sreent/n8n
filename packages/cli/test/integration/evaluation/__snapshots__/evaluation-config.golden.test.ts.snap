exports[`the quota of workflows with evaluations 1`] = `
{
  "quota 0, first workflow": {
    "result": {
      "<class>": "EvaluationConfig",
      "createdAt": "<Date>",
      "datasetRef": {
        "dataTableId": "@table",
      },
      "datasetSource": "data_table",
      "endNodeName": "Answer",
