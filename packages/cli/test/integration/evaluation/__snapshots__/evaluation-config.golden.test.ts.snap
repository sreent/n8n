            "outputType": "boolean",
          },
          "id": "m1",
          "name": "Exact match",
          "type": "expression",
        },
      ],
      "name": "q0",
      "startNodeName": "Start",
      "status": "valid",
      "updatedAt": "<Date>",
      "workflowId": "@workflow",
    },
  },
  "quota 0, second workflow": {
    "code": "END_NODE_UNREACHABLE",
