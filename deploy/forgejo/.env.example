# The settings of Forgejo. Copy this file to .env and set the values. See README.md.

# The image of Forgejo: the rootless variant of the long-term support line 15. To upgrade, change
# the version, then follow "Upgrade" in README.md.
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15.0.10-rootless

# The internal name of the server, for example git.corp.internal. The n8n instances reach
# Forgejo with this name, and the certificate of Caddy is for this name.
FORGEJO_DOMAIN=git.corp.internal

# The first admin user. setup.sh makes it with a random password.
FORGEJO_ADMIN_USERNAME=platform-admin
FORGEJO_ADMIN_EMAIL=platform-admin@example.com

# The organisation and the private repository that setup.sh makes for the workflows of n8n.
FORGEJO_ORG=n8n
FORGEJO_REPO=workflows

# The Cloud Storage bucket for the backups: the BACKUP_BUCKET of gcp-create.sh, for example
# my-project-forgejo-backups. backup.sh copies each backup to it. When it is empty, the backups
# stay on the VM only.
BACKUP_BUCKET=
