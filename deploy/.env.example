# Copy this file to .env, then set the values. Keep .env private: it holds the secrets.

# The host name of n8n. Point its DNS record at this server first.
DOMAIN=n8n.example.com

# The n8n image to run.
N8N_IMAGE=ghcr.io/sreent/n8n:latest

# Make each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
# n8n encrypts the credentials with this key. Keep a copy outside the server, for example in a
# password manager. Without this key, a backup cannot be restored.
N8N_ENCRYPTION_KEY=

TIMEZONE=UTC

# Git sync: the hosts that a repository URL can use. Leave it empty to allow all hosts.
GIT_SYNC_ALLOWED_HOSTS=github.com

# The ports on this server. Caddy needs 80 and 443 to get the HTTPS certificate.
HTTP_PORT=80
HTTPS_PORT=443
