# Copy this file to .env, then set the values. Keep .env private: it holds the secrets.

# The host name of n8n. Point its DNS record at this server first.
DOMAIN=n8n.example.com

# The images to run. Use the same tag for both: the runners must have the version of n8n.
N8N_IMAGE=ghcr.io/sreent/n8n:latest
N8N_RUNNERS_IMAGE=ghcr.io/sreent/n8n-runners:latest

# Make each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
# n8n encrypts the credentials with this key. Keep a copy outside the server, for example in a
# password manager. Without this key, a backup cannot be restored.
N8N_ENCRYPTION_KEY=
# The runners use this token to connect to n8n.
N8N_RUNNERS_AUTH_TOKEN=

TIMEZONE=UTC

# Git sync: the hosts that a repository URL can use. Leave it empty to allow all hosts.
GIT_SYNC_ALLOWED_HOSTS=github.com

# The features that the fork turns on without a licence: sharing, team projects, the project
# roles, the admin role, custom roles, SSO, external secrets, variables, execution annotations,
# evaluations, API key scopes, folders, debug in editor, insights, data redaction, the custom span
# attributes of OpenTelemetry, node type policies and the personal space policy. Set false to turn
# them off. The fork needs no licence key.
FORK_FEATURES_ENABLED=true

# The n8n modules to load in addition to the default modules, separated by commas. Node type
# policies need their module (type-availability-policies) and the fork features. Leave it empty to
# turn off node type policies.
ENABLED_MODULES=type-availability-policies

# The ports on this server. Caddy needs 80 and 443 to get the HTTPS certificate.
HTTP_PORT=80
HTTPS_PORT=443
