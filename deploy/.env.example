# Copy this file to .env, then set the values. Keep .env private: it holds the secrets.

# The host name of n8n. Point its DNS record at this server first.
DOMAIN=n8n.example.com

# The images to run. Use the same tag for both: the runners must have the version of n8n.
N8N_IMAGE=ghcr.io/sreent/n8n:latest
N8N_RUNNERS_IMAGE=ghcr.io/sreent/n8n-runners:latest

# Make each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
# n8n encrypts the credentials with this key. Keep a copy outside the server, for example in a
# password manager. Without this key, a backup cannot be restored.
N8N_ENCRYPTION_KEY=
# The runners use this token to connect to n8n.
N8N_RUNNERS_AUTH_TOKEN=

TIMEZONE=UTC

# Git sync: the hosts that a repository URL can use. Leave it empty to allow all hosts.
GIT_SYNC_ALLOWED_HOSTS=github.com

# The features that the fork turns on without a licence: sharing, team projects, the project
# roles, the admin role, custom roles, SSO, external secrets, variables, execution annotations,
# evaluations, API key scopes, folders, debug in editor, insights, data redaction, the custom span
# attributes of OpenTelemetry, node type policies, the personal space policy, MFA enforcement, the
# diffs and the names of workflow versions, the private registry of community nodes, token
# exchange, workflow reviews, the S3 and Azure Blob storage, source control, Git connections,
# multiple main instances, the worker view, worker pools, LDAP, dynamic credentials and the AI
# gateway. Set false to turn them off. The fork needs no licence key.
FORK_FEATURES_ENABLED=true

# Set true on a development or test server: each page then shows a banner that tells that the
# instance is not for production. Keep false on the production server.
NON_PRODUCTION_BANNER=false

# The hours that n8n keeps old workflow versions. -1 keeps all versions. n8n always keeps the
# saved version and the published version of each workflow.
WORKFLOW_HISTORY_PRUNE_TIME=-1

# SSRF protection. A node cannot call private, loopback or link-local addresses until you open the
# host here: host names (*.corp.internal matches the subdomains) and IP ranges, separated by commas,
# for example SSRF_ALLOWED_HOSTNAMES=crm.corp.internal and SSRF_ALLOWED_IP_RANGES=10.20.0.5/32.
# SSRF_PROTECTION=false turns the protection off.
SSRF_PROTECTION=true
SSRF_ALLOWED_HOSTNAMES=
SSRF_ALLOWED_IP_RANGES=

# The hours that a session lasts. With SESSION_RENEWAL_HOURS=0, a request in the last quarter of a
# session renews it, so users stay signed in while they work, and a session without use ends. With
# -1, each session ends SESSION_HOURS after the sign-in, also during work, and the editor loses the
# changes that are not saved. Deleting or disabling a user ends their sessions at once.
SESSION_HOURS=12
SESSION_RENEWAL_HOURS=0

# The security policy of Settings > Security & policies. At each start n8n sets these values, and
# the page shows them read-only. SECURITY_POLICY_FROM_ENV=false lets the admins set them on the
# page instead.
SECURITY_POLICY_FROM_ENV=true
# Users who sign in with a password (email or LDAP) must use two-factor authentication. OIDC and
# SAML users use the second factor of their identity provider.
MFA_ENFORCED=true
# Users can publish and share the workflows of their personal spaces.
PERSONAL_SPACE_PUBLISHING=false
PERSONAL_SPACE_SHARING=false
# Users can send a workflow version to a reviewer, and the approval publishes it.
WORKFLOW_REVIEWS=true
# A new webhook, form, public chat or MCP server without authentication publishes only after an
# approval in a workflow review. The editor offers a one-click fix: a token for webhooks and MCP
# servers, n8n sign-in for forms and chats. The triggers that are published now keep running.
OPEN_TRIGGERS_NEED_APPROVAL=true
# The execution data that n8n hides for all workflows: off, production (the executions that a
# trigger starts) or all (also the manual executions).
REDACTION_FLOOR=off

# SSO: the sign-in with OIDC, for example with Microsoft Entra ID, Okta, Google or Keycloak. With
# SSO_FROM_ENV=true, n8n sets the OIDC sign-in from these values at each start, and the roles come
# from the SSO group rules (platform/README.md). The redirect URL of n8n is
# https://<DOMAIN>/rest/sso/oidc/callback. With SSO_FROM_ENV=false, the admins set SSO (also SAML)
# on the page Settings > SSO.
SSO_FROM_ENV=false
# Ends with /.well-known/openid-configuration.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# More scopes, separated by spaces, for example groups when the identity provider sends the groups
# only for that scope.
OIDC_ADDITIONAL_SCOPES=

# The IP ranges that can call webhooks, chats and MCP servers, and the IP ranges that can open and
# send forms, separated by spaces, for example 10.0.0.0/8 203.0.113.0/24. Empty: all addresses.
WEBHOOK_ALLOWED_RANGES=
FORM_ALLOWED_RANGES=

# Install community nodes from your own npm registry, for example AWS CodeArtifact, Azure Artifacts
# or Google Artifact Registry. Leave both empty to use the public npm registry.
COMMUNITY_PACKAGES_REGISTRY=
COMMUNITY_PACKAGES_AUTH_TOKEN=

# The n8n modules to load in addition to the default modules, separated by commas. Node type
# policies (type-availability-policies) and Git connections (promotions) need their modules and the
# fork features. Leave it empty to turn off node type policies and Git connections.
ENABLED_MODULES=type-availability-policies,promotions
# The editor of Git connections (Settings > Environments v2 and the banners of the projects).
# false hides it. The public API of Git connections stays.
PROMOTIONS_EDITOR=true
# The credential resolvers of dynamic credentials (Settings > Credential resolvers), the resolver
# setting of a workflow, the hooks of the Webhook node and the Dynamic Credential Check node.
# false hides them. The end-user credentials of each n8n user stay.
CREDENTIAL_RESOLVERS=true
# The apps that call the endpoints of dynamic credentials (the execution status of a workflow,
# authorize and revoke): the origins that a browser can call them from, separated by commas, and
# a token for a caller without an n8n session (make it with `openssl rand -hex 32`). The caller
# sends the token in the header `X-Authorization: Bearer <token>`. Leave both empty when no app
# calls them.
DYNAMIC_CREDENTIALS_CORS_ORIGIN=
DYNAMIC_CREDENTIALS_ENDPOINT_AUTH_TOKEN=

# The ports on this server. Caddy needs 80 and 443 to get the HTTPS certificate.
HTTP_PORT=80
HTTPS_PORT=443
